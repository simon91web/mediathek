{
  "name": "mediathek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3200",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3200",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx --tsconfig tsconfig.scripts.json e2e/prepare.ts && playwright test",
    "e2e:ui": "tsx --tsconfig tsconfig.scripts.json e2e/prepare.ts && playwright test --ui",
    "doktor": "tsx --tsconfig tsconfig.scripts.json scripts/doktor.ts",
    "fixtures": "tsx --tsconfig tsconfig.scripts.json scripts/fixtures.ts",
    "setup:python": "node scripts/setup-python.mjs",
    "probe:whisper": "node scripts/setup-python.mjs --probe-only"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vidstack/react": "1.15.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "minisearch": "^7.2.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
